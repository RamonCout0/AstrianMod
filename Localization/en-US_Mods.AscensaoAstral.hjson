		Bestiario: {
			Silvanna: "An ice witch and the hat that thinks for itself. She never wanted the Astrania: she wanted to know who was strong enough to tear it from the ground."
			Astharoth: "A warrior wandering between this world and the Ether. He cuts through space like opening a door, and believes every soul has two halves."
		}

		BossChecklist: {
			RaidSilvanna.Invocar: "Use the Witch's Call in the snow biome, after Queen Slime. Outside the snow she fights enraged."
			Astharoth.Invocar: "Use the Wanderer's Call after Golem to open the raid."
			InvernoEterno.Invocar: "Talk to Silvanna and choose Challenge after the Moon Lord (with Calamity, after Providence)."
			InvernoEterno.Nome: "Silvanna: the Eternal Winter"
		}

		Configs: {
