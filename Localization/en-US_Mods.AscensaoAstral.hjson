				DisplayName: "Ascensão Astral"
				ModoDeTeste: {
					Label: "Test mode"
					Tooltip: "Enables the test items (Test Tool, Bot Controller), the /vitrine command and the diagnostics line. Summoning items are not consumed and ignore their requirements. Leave off for normal play."
