Mods: {
	AscensaoAstral: {
		Items: {
			ControleDoBot: {
				DisplayName: Bot Controller
				Tooltip: ""
			}
			Astrania: {
				DisplayName: Astrânia
				Tooltip: "'Pulsa como se tivesse um coração'"
			}
			ChamadoDaBruxa: {
				DisplayName: Chamado da Bruxa
				Tooltip:
					'''
					Começa a Raid da Silvanna
					Use no bioma da neve, depois da Queen Slime
					'''
			}
			FerramentaDeTeste: {
				DisplayName: Ferramenta de Teste
				Tooltip: "[DEBUG] Cada uso avança a história: 1º libera a Astrânia, 2º cria a cratera ao seu lado, depois te leva até ela"
			}
			LaminaErrante: {
				DisplayName: Lâmina Errante
				Tooltip:
					'''
					Começa a Raid do Astharoth
					Depois do Golem
					'''
			}
			GeloEterno: {
				DisplayName: Eternal Ice
				Tooltip: "'It won't melt, not even in Hell'"
			}
			LancaDeArmotheus: {
				DisplayName: "Armotheus' Lance"
				Tooltip: "Thrusts leave frost under the enemy, and the frost becomes a spike"
			}
			CajadoDoPingente: {
				DisplayName: Icicle Staff
				Tooltip: "A giant icicle forms above the cursor, sticks into the ground and shatters"
			}
			LancadorDeAvalanche: {
				DisplayName: Avalanche Launcher
				Tooltip: "Uses snowballs\nSnowballs roll along the terrain, growing and piercing enemies"
			}
			CoracaoDeArmotheus: {
				DisplayName: Heart of Armotheus
				Tooltip: "Immunity to cold and freezing\nTaking damage grants an ice shield for 5 seconds (25 s cooldown)"
			}
			BolsaDaSilvanna: {
				DisplayName: Treasure Bag (Silvanna)
				Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
			}
			FragmentoDoEter: {
				DisplayName: Ether Fragment
				Tooltip: "'Weighs nothing, and too much'"
			}
			LaminaDoErrante: {
				DisplayName: "Wanderer's Blade"
				Tooltip: "Each swing opens a rift ahead that releases an ether crescent"
			}
			ArcoDoArcanjo: {
				DisplayName: "Archangel's Bow"
				Tooltip: "Turns arrows into arrows of light\nThey split into a fan of feathers"
			}
			TomoDoJulgamento: {
				DisplayName: Tome of Judgment
				Tooltip: "A pillar of light falls from the sky onto the cursor"
			}
			EcoDoEter: {
				DisplayName: Ether Echo
				Tooltip: "Taking damage slips you into the Ether for a moment: intangible, and the echo explodes (20 s cooldown)"
			}
			BolsaDoAstharoth: {
				DisplayName: Treasure Bag (Astharoth)
				Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
			}
		}

		Keybinds: {
			UltimateDaFusao.DisplayName: Fusion Ultimate
		}

