Mods: {
	AscensaoAstral: {
		Items: {
			ControleDoBot: {
				DisplayName: Bot Controller
				Tooltip: ""
			}
			Astrania: {
				DisplayName: Astrânia
				Tooltip: "'Pulsa como se tivesse um coração'"
			}
			ChamadoDaBruxa: {
				DisplayName: Chamado da Bruxa
				Tooltip:
					'''
					Começa a Raid da Silvanna
					Use no bioma da neve, depois da Queen Slime
					'''
			}
			FerramentaDeTeste: {
				DisplayName: Ferramenta de Teste
				Tooltip: "[DEBUG] Cada uso avança a história: 1º libera a Astrânia, 2º cria a cratera ao seu lado, depois te leva até ela"
			}
			LaminaErrante: {
				DisplayName: Lâmina Errante
				Tooltip:
					'''
					Começa a Raid do Astharoth
					Depois do Golem
					'''
			}
			GeloEterno: {
				DisplayName: Eternal Ice
				Tooltip: "'It won't melt, not even in Hell'"
			}
			LancaDeArmotheus: {
				DisplayName: "Armotheus' Lance"
				Tooltip: "Thrusts leave frost under the enemy, and the frost becomes a spike"
			}
			CajadoDoPingente: {
				DisplayName: Icicle Staff
				Tooltip: "A giant icicle forms above the cursor, sticks into the ground and shatters"
			}
			LancadorDeAvalanche: {
				DisplayName: Avalanche Launcher
				Tooltip: "Uses snowballs\nSnowballs roll along the terrain, growing and piercing enemies"
			}
			CoracaoDeArmotheus: {
				DisplayName: Heart of Armotheus
				Tooltip: "Immunity to cold and freezing\nTaking damage grants an ice shield for 5 seconds (25 s cooldown)"
			}
			BolsaDaSilvanna: {
				DisplayName: Treasure Bag (Silvanna)
				Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
			}
			FragmentoDoEter: {
				DisplayName: Ether Fragment
				Tooltip: "'Weighs nothing, and too much'"
			}
			LaminaDoErrante: {
				DisplayName: "Wanderer's Blade"
				Tooltip: "Each swing opens a rift ahead that releases an ether crescent"
			}
			ArcoDoArcanjo: {
				DisplayName: "Archangel's Bow"
				Tooltip: "Turns arrows into arrows of light\nThey split into a fan of feathers"
			}
			TomoDoJulgamento: {
				DisplayName: Tome of Judgment
				Tooltip: "A pillar of light falls from the sky onto the cursor"
			}
			EcoDoEter: {
				DisplayName: Ether Echo
				Tooltip: "Taking damage slips you into the Ether for a moment: intangible, and the echo explodes (20 s cooldown)"
			}
			BolsaDoAstharoth: {
				DisplayName: Treasure Bag (Astharoth)
				Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
			}
			ChapeuDeArmotheus: {
				DisplayName: "Armotheus' Hat"
				Tooltip: "Vanity\n'He sulks when you wear it'"
			}
			ElmoDoErrante: {
				DisplayName: "Wanderer's Helm"
				Tooltip: "Vanity"
			}
			TrofeuDaSilvanna: {
				DisplayName: "Silvanna Trophy"
				Tooltip: ""
			}
			TrofeuDoAstharoth: {
				DisplayName: "Astharoth Trophy"
				Tooltip: ""
			}
			RelicariaDaSilvanna: {
				DisplayName: "Silvanna Relic"
				Tooltip: ""
			}
			RelicariaDoAstharoth: {
				DisplayName: "Astharoth Relic"
				Tooltip: ""
			}
			CartolaDeArmotheus: {
				DisplayName: "Armotheus' Top Hat"
				Tooltip: "Summons a Mini Armotheus"
			}
			OvoDoEter: {
				DisplayName: "Ether Egg"
				Tooltip: "Summons a Mini Ether Dragon"
			}
			CajadoDosCavaleiros: {
				DisplayName: "Staff of the Sky Knights"
				Tooltip: "Summons an ice knight that throws lances at enemies"
			}
			CajadoDoDragao: {
				DisplayName: "Ether Dragon Staff"
				Tooltip: "Summons a little Ether dragon that lunges at enemies"
			}
			PingenteDeArremesso: {
				DisplayName: "Throwing Icicle"
				Tooltip: "Sticks where it lands and shatters into shards"
			}
			AdagaDoErrante: {
				DisplayName: "Wanderer's Dagger"
				Tooltip: "Opens a rift where it hits, releasing an ether crescent"
			}
			EssenciaDoInverno: {
				DisplayName: "Essence of Winter"
				Tooltip: "'The cold left over from the Eternal Winter'"
			}
			CoroaDoInvernoEterno: {
				DisplayName: "Crown of the Eternal Winter"
				Tooltip: "10% increased damage and 5% increased critical strike chance\nImmunity to cold and freezing\nEvery 2 seconds, an ice shard flies at the nearest enemy"
			}
		}

