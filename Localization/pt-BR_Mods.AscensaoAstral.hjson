Mods: {
	AscensaoAstral: {
		Items: {
			ControleDoBot: {
				DisplayName: Controle do Bot
				Tooltip: ""
			}
			Astrania: {
				DisplayName: Astrânia
				Tooltip: "'Pulsa como se tivesse um coração'"
			}
			ChamadoDaBruxa: {
				DisplayName: Chamado da Bruxa
				Tooltip:
					'''
					Chama a Silvanna e o Armotheus
					Use no bioma da neve, depois da Queen Slime (fora da neve ela luta enfurecida)
					'''
			}
			InvocadorDeTeste: {
				DisplayName: Invocador de Teste
				Tooltip: "[TESTE] Invoca a Sentinela, o boss do guia. Não é consumido"
			}
			FerramentaDeTeste: {
				DisplayName: Ferramenta de Teste
				Tooltip: "[DEBUG] Cada uso avança a história: 1º libera a Astrânia, 2º cria a cratera ao seu lado, depois te leva até ela"
			}
			LaminaErrante: {
				DisplayName: Chamado do Errante
				Tooltip:
					'''
					Começa a Raid do Astharoth
					Depois do Golem
					'''
			}
			GeloEterno: {
				DisplayName: Gelo Eterno
				Tooltip: "'Não derrete nem no Inferno'"
			}
			LancaDeArmotheus: {
				DisplayName: Lança de Armotheus
				Tooltip: "A estocada deixa geada sob o inimigo, e a geada vira espinho"
			}
			CajadoDoPingente: {
				DisplayName: Cajado do Pingente
				Tooltip: "Um pingente gigante se forma sobre o cursor, crava no chão e estilhaça"
			}
			LancadorDeAvalanche: {
				DisplayName: Lançador de Avalanche
				Tooltip: "Usa bolas de neve\nAs bolas rolam pelo terreno, crescendo e atravessando inimigos"
			}
			CoracaoDeArmotheus: {
				DisplayName: Coração de Armotheus
				Tooltip: "Imunidade ao frio e ao congelamento\nAo levar dano, um escudo de gelo te protege por 5 segundos (recarga de 25 s)"
			}
			BolsaDaSilvanna: {
				DisplayName: Bolsa do Tesouro (Silvanna)
				Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
			}
			FragmentoDoEter: {
				DisplayName: Fragmento do Éter
				Tooltip: "'Pesa nada e, ao mesmo tempo, demais'"
			}
			LaminaDoErrante: {
				DisplayName: Lâmina do Errante
				Tooltip: "Cada golpe abre uma fenda à frente, e dela sai uma meia-lua de éter"
			}
			ArcoDoArcanjo: {
				DisplayName: Arco do Arcanjo
				Tooltip: "Transforma as flechas em flechas de luz\nElas se abrem num leque de penas"
			}
			TomoDoJulgamento: {
				DisplayName: Tomo do Julgamento
				Tooltip: "Um pilar de luz cai do céu sobre o cursor"
			}
			EcoDoEter: {
				DisplayName: Eco do Éter
				Tooltip: "Ao levar dano, você escorrega para o Éter por um instante: fica intangível e o eco explode (recarga de 20 s)"
			}
			BolsaDoAstharoth: {
				DisplayName: Bolsa do Tesouro (Astharoth)
				Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
			}
			ChapeuDeArmotheus: {
				DisplayName: "Chapéu de Armotheus"
				Tooltip: "Visual\n'Ele fica emburrado quando você usa'"
			}
			ElmoDoErrante: {
				DisplayName: "Elmo do Errante"
				Tooltip: "Visual"
			}
			TrofeuDaSilvanna: {
				DisplayName: "Troféu da Silvanna"
				Tooltip: ""
			}
			TrofeuDoAstharoth: {
				DisplayName: "Troféu do Astharoth"
				Tooltip: ""
			}
			RelicariaDaSilvanna: {
				DisplayName: "Relíquia da Silvanna"
				Tooltip: ""
			}
			RelicariaDoAstharoth: {
				DisplayName: "Relíquia do Astharoth"
				Tooltip: ""
			}
			CartolaDeArmotheus: {
				DisplayName: "Cartola de Armotheus"
				Tooltip: "Invoca um Mini Armotheus"
			}
			OvoDoEter: {
				DisplayName: "Ovo do Éter"
				Tooltip: "Invoca um Mini Dragão do Éter"
			}
			CajadoDosCavaleiros: {
				DisplayName: "Cajado dos Cavaleiros do Céu"
				Tooltip: "Invoca um cavaleiro de gelo que arremessa lanças nos inimigos"
			}
			CajadoDoDragao: {
				DisplayName: "Cajado do Dragão do Éter"
				Tooltip: "Invoca um dragãozinho do Éter que dá botes nos inimigos"
			}
			PingenteDeArremesso: {
				DisplayName: "Pingente de Arremesso"
				Tooltip: "Crava onde bater e estilhaça em lascas"
			}
			AdagaDoErrante: {
				DisplayName: "Adaga do Errante"
				Tooltip: "Onde acerta, abre uma fenda que solta uma meia-lua de éter"
			}
			EssenciaDoInverno: {
				DisplayName: "Essência do Inverno"
				Tooltip: "'O frio que sobrou do Inverno Eterno'"
			}
			CoroaDoInvernoEterno: {
				DisplayName: "Coroa do Inverno Eterno"
				Tooltip: "10% a mais de dano e 5% a mais de chance de crítico\nImunidade ao frio e ao congelamento\nA cada 2 segundos, uma lasca de gelo vai até o inimigo mais perto"
			}
		}

