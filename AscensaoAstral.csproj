<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\tModLoader.targets" />
  <PropertyGroup>
    <AssemblyName>AscensaoAstral</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="tModLoader.CodeAssist" Version="0.1.*" />
  </ItemGroup>
  <!-- Só para o autocompletar do editor: o build do jogo acha a Luminance pelo build.txt -->
  <ItemGroup Condition="Exists('lib\Luminance.dll')">
    <Reference Include="Luminance">
      <HintPath>lib\Luminance.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
